# --- App ---
APP_NAME="Graduate Skill Gap Prediction System"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./skillgap.db

# --- Auth / JWT ---
SECRET_KEY=change-this-to-a-random-64-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:

# --- AI (Google Gemma) ---
# Point this at your local Gemma inference server or hosted endpoint.
GEMMA_API_URL=http://localhost:11434/api/generate
GEMMA_MODEL_NAME=gemma2

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
